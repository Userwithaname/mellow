#!/usr/bin/sh

# This hook uses a local clone of this repository to test the new commit before pushing.
# If it fails any tests or contains compiler errors, the commit will not be pushed.
#
# A local clone named `mellow_bridge` will be created next to this source directory when
# first running this hook, where latest commit will be tested. Note that `mellow_bridge`
# will not be connected to Github.
#
# In order to use it:
# Copy or create a symbolic link from `tests/git-hooks` to `.git/hooks`.
#
# WARNING: This hook should not be enabled in the `mellow_bridge` clone

mellow=$(git rev-parse --show-toplevel)
mellow_bridge="$mellow/../mellow_bridge"

echo "Updating $(realpath "$mellow_bridge"):"
cd "$mellow_bridge" || {
	git clone "$mellow" "$mellow_bridge" \
	&& ln -s "$mellow/target" "$mellow_bridge/target" \
	; cd "$mellow_bridge"
} && git pull --rebase --force || exit 1

echo

cargo test --all-features || {
	  echo && cd - \
	  && echo "Please fix any errors introduced by the commit, then try again." \
		&& exit 1
}

echo

cd - && exit 0
