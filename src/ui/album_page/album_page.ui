<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <menu id="play_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Sequential</attribute>
        <attribute name='action'>menu.album_page_play_mode</attribute>
        <attribute name='target' type='s'>"Sequential"</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Shuffled</attribute>
        <attribute name='action'>menu.album_page_play_mode</attribute>
        <attribute name='target' type='s'>"Shuffled"</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Add To Queue</attribute>
        <attribute name='action'>player.queue_visible_album</attribute>
      </item>
    </section>
  </menu>
  <template class="MellowAlbumPage" parent="AdwNavigationPage">

    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-title">false</property>
            <child type="end">
              <object class="AdwSplitButton" id="play_button">
                <signal name="clicked" handler="handle_play_now" swapped="true"/>
                <property name="menu-model">play_menu</property>
                <property name="icon-name">media-playback-start-symbolic</property>
                <property name="tooltip-text" translatable="yes">Play All</property>
              </object>
            </child>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage" id="album_pref_page">
            <property name="valign">center</property>
            <child>
              <object class="AdwPreferencesGroup">

                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="halign">center</property>

                    Album artwork
                    <child>
                      <object class="GtkPicture" id="album_cover">
                        <property name="margin-start">16</property>
                        <property name="margin-end">16</property>
                        <property name="content-fit">contain</property>
                        <property name="halign">center</property>
                        <property name="width-request">256</property>
                        <property name="height-request">256</property>
                        <style>
                          <class name="card"/>
                        </style>
                      </object>
                    </child>

                    Album info
                    <child>
                      <object class="GtkBox">
                        <property name="margin-top">12</property>
                        <property name="spacing">6</property>
                        <property name="orientation">vertical</property>
                        <child>
                          <object class="GtkLabel" id="details">
                            <property name="wrap">true</property>
                            <property name="wrap-mode">word</property>
                            <property name="justify">center</property>
                            <style>
                              <class name="caption-heading"/>
                              <class name="dimmed"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="artist_name">
                            <property name="wrap">true</property>
                            <property name="wrap-mode">word</property>
                            <property name="justify">center</property>
                            <style>
                              <class name="caption-heading"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="album_title">
                            <property name="wrap">true</property>
                            <property name="wrap-mode">word</property>
                            <property name="justify">center</property>
                            <style>
                              <class name="heading"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="year">
                            <property name="margin-bottom">8</property>
                            <style>
                              <class name="caption-heading"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="MellowRating" id="rating"/>
                        </child>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup">

                <child>
                  <object class="AdwActionRow">
                    <signal name="activated" handler="handle_go_to_artist" swapped="true"/>
                    <property name="title" translatable="yes">Go To Artist</property>
                    <property name="activatable">true</property>
                    <child type="prefix">
                      <object class="GtkImage">
                        <property name="icon-name">avatar-default-symbolic</property>
                      </object>
                    </child>
                    <child type="suffix">
                      <object class="GtkImage">
                        <property name="icon-name">go-next-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

          </object>
        </property>
      </object>
    </property>

  </template>
</interface>
