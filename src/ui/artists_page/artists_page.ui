<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <menu id="play_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Sequential</attribute>
        <attribute name='action'>menu.artists_play_mode</attribute>
        <attribute name='target' type='s'>"Sequential"</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Shuffled</attribute>
        <attribute name='action'>menu.artists_play_mode</attribute>
        <attribute name='target' type='s'>"Shuffled"</attribute>
      </item>
    </section>
  </menu>
  <menu id="sort_menu">
    <section>
      <item>
        <attribute name="label" translatable="yes">Default</attribute>
        <attribute name='action'>menu.artists_sort_mode</attribute>
        <attribute name='target' type='s'>"Default"</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Rating</attribute>
        <attribute name='action'>menu.artists_sort_mode</attribute>
        <attribute name='target' type='s'>"Rating"</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Play Count</attribute>
        <attribute name='action'>menu.artists_sort_mode</attribute>
        <attribute name='target' type='s'>"Play Count"</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Added</attribute>
        <attribute name='action'>menu.artists_sort_mode</attribute>
        <attribute name='target' type='s'>"Added"</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Modified</attribute>
        <attribute name='action'>menu.artists_sort_mode</attribute>
        <attribute name='target' type='s'>"Modified"</attribute>
      </item>
      <item>
        <attribute name="label" translatable="yes">Random</attribute>
        <attribute name='action'>menu.artists_sort_mode</attribute>
        <attribute name='target' type='s'>"Random"</attribute>
      </item>
    </section>
  </menu>
  <template class="MellowArtistsPage" parent="AdwNavigationPage">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">

            <child type="start">
              <object class="AdwSplitButton" id="sort_button">
                <signal name="clicked" handler="handle_reverse_sort" swapped="true"/>
                <property name="menu-model">sort_menu</property>
                <property name="icon-name">view-sort-descending-symbolic</property>
                <property name="tooltip-text" translatable="yes">Ordering</property>
              </object>
            </child>

            <child type="title">
              <object class="AdwClamp">
                <child>
                  <object class="GtkSearchEntry" id="search_entry">
                    <signal name="activate" handler="handle_activate" swapped="true"/>
                    <signal name="stop_search" handler="handle_stop_search" swapped="true"/>
                    <signal name="search_changed" handler="handle_search_changed" swapped="true"/>
                    <property name="hexpand">true</property>
                  </object>
                </child>
              </object>
            </child>

            <child type="end">
              <object class="AdwSplitButton" id="play_button">
                <signal name="clicked" handler="handle_play_now" swapped="true"/>
                <property name="menu-model">play_menu</property>
                <property name="icon-name">media-playback-start-symbolic</property>
                <property name="tooltip-text" translatable="yes">Play All</property>
              </object>
            </child>

            <child type="end">
              <!-- TODO: Move this button into the search bar instead (like Nautilus does) -->
              <object class="GtkMenuButton">
                <property name="tooltip-text" translatable="yes">Filter Artists</property>
                <property name="icon-name">radio-mixed-symbolic</property>
                <property name="popover">
                  <object class="GtkPopover">
                    <property name="width-request">480</property>
                    <property name="autohide">true</property>

                    <child type="content">
                      <object class="AdwPreferencesPage">
                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Filter Artists</property>

                            <child type="header-suffix">
                              <object class="GtkBox">
                                <child>
                                  <object class="GtkLabel">
                                    <property name="label">Require</property>
                                    <property name="margin-end">8</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwToggleGroup" id="filter_mode">
                                    <property name="homogeneous">true</property>
                                    <property name="active-name">All</property>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name" translatable="yes">Any</property>
                                        <property name="label" translatable="yes">Any</property>
                                        <property name="tooltip" translatable="yes">Show items which match any of the selected filters</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="AdwToggle">
                                        <property name="name" translatable="yes">All</property>
                                        <property name="label" translatable="yes">All</property>
                                        <property name="tooltip" translatable="yes">Only show items which match all of the selected filters</property>
                                      </object>
                                    </child>
                                    <style>
                                      <class name="round"/>
                                    </style>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwSpinRow" id="rating_spin_row">
                                <signal name="notify::value" handler="handle_filters_changed" swapped="true"/>
                                <property name="title" translatable="yes">Rating</property>
                                <property name="adjustment">
                                  <object class="GtkAdjustment">
                                    <property name="step-increment">1</property>
                                    <property name="lower">0</property>
                                    <property name="upper">5</property>
                                    <property name="value">3</property>
                                  </object>
                                </property>
                                <child type="prefix">
                                  <object class="GtkCheckButton" id="rating_checkbox">
                                    <signal name="toggled" handler="handle_filters_changed" swapped="true"/>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkBox">
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">stars</property>
                                        <property name="margin-end">8</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkDropDown" id="rating_condition">
                                        <signal name="notify::selected" handler="handle_filters_changed" swapped="true"/>
                                        <property name="vexpand">false</property>
                                        <property name="hexpand">false</property>
                                        <property name="valign">center</property>
                                        <property name="halign">center</property>
                                        <property name="model">
                                          <object class="GtkStringList">
                                            <items>
                                              <item translatable="yes">or more</item>
                                              <item translatable="yes">or less</item>
                                            </items>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>

                            <child>
                              <object class="AdwSpinRow" id="play_count_spin_row">
                                <signal name="notify::value" handler="handle_filters_changed" swapped="true"/>
                                <property name="title" translatable="yes">Played</property>
                                <property name="adjustment">
                                  <object class="GtkAdjustment">
                                    <property name="page-increment">10</property>
                                    <property name="step-increment">1</property>
                                    <property name="lower">0</property>
                                    <property name="upper">9999</property>
                                    <property name="value">0</property>
                                  </object>
                                </property>
                                <child type="prefix">
                                  <object class="GtkCheckButton" id="play_count_checkbox">
                                    <signal name="toggled" handler="handle_filters_changed" swapped="true"/>
                                  </object>
                                </child>
                                <child type="suffix">
                                  <object class="GtkBox">
                                    <child>
                                      <object class="GtkLabel">
                                        <property name="label" translatable="yes">times</property>
                                        <property name="margin-end">8</property>
                                      </object>
                                    </child>
                                    <child>
                                      <object class="GtkDropDown" id="play_count_condition">
                                        <signal name="notify::selected" handler="handle_filters_changed" swapped="true"/>
                                        <property name="vexpand">false</property>
                                        <property name="hexpand">false</property>
                                        <property name="valign">center</property>
                                        <property name="halign">center</property>
                                        <property name="model">
                                          <object class="GtkStringList">
                                            <items>
                                              <item translatable="yes">or more</item>
                                              <item translatable="yes">or less</item>
                                            </items>
                                          </object>
                                        </property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>

                          </object>
                        </child>

                        <child>
                          <object class="AdwPreferencesGroup">
                            <property name="title" translatable="yes">Filter By Tags</property>
                            <child type="header-suffix">
                              <object class="AdwToggleGroup" id="tag_filter_mode">
                                <property name="homogeneous">true</property>
                                <property name="active-name">Any</property>
                                <child>
                                  <object class="AdwToggle">
                                    <property name="name" translatable="yes">Any</property>
                                    <property name="label" translatable="yes">Any</property>
                                    <property name="tooltip" translatable="yes">Show items which match any of the selected tags</property>
                                  </object>
                                </child>
                                <child>
                                  <object class="AdwToggle">
                                    <property name="name" translatable="yes">All</property>
                                    <property name="label" translatable="yes">All</property>
                                    <property name="tooltip" translatable="yes">Only show items which match all of the selected tags</property>
                                  </object>
                                </child>
                                <style>
                                  <class name="round"/>
                                </style>
                              </object>
                            </child>

                            <child>
                              <object class="AdwWrapBox" id="filtered_tags">
                                <property name="child-spacing">6</property>
                                <property name="line-spacing">6</property>
                                <style>
                                  <class name="round"/>
                                  <class name="compact"/>
                                </style>
                              </object>
                            </child>

                          </object>
                        </child>

                      </object>

                    </child>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </child>

        <property name="content">

          <object class="AdwViewStack" id="view_stack">

            <child>
              <object class="AdwViewStackPage">
                <property name="name">empty</property>
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="icon-name">avatar-default-symbolic</property>
                    <property name="title" translatable="yes">Artists</property>
                    <property name="description" translatable="yes">Artists are currently unavailable</property>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="AdwViewStackPage">
                <property name="name">artists</property>
                <property name="child">
                  <object class="GtkScrolledWindow">
                    <child>
                      <object class="GtkGridView" id="artists_grid">
                        <property name="single-click-activate">true</property>
                        <style>
                          <class name="card"/>
                        </style>
                      </object>
                    </child>
                  </object>
                </property>
              </object>
            </child>

            <child>
              <object class="AdwViewStackPage">
                <property name="name">artists_placeholder</property>
                  <!-- IDEA: Button to scroll to the currently playing artist -->
                <property name="child">
                  <object class="AdwStatusPage">
                    <property name="icon-name">avatar-default-symbolic</property>
                    <property name="title" translatable="yes">Artists</property>
                    <property name="description" translatable="yes">Artists will appear here in a future version</property>
                  </object>
                </property>
              </object>
            </child>

          </object>
        </property>
      </object>
    </property>
  </template>
</interface>
