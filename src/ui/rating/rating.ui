<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MellowRating" parent="GtkBox">
    <property name="halign">center</property>
    <property name="valign">center</property>
    <property name="spacing">12</property>
    <child>
      <object class="GtkButton" id="favorite_button">
        <signal name="clicked" handler="handle_toggle_favorite" swapped="true"/>
        <property name="icon-name">emote-love-symbolic</property>
        <style>
          <class name="circular"/>
          <class name="flat"/>
        </style>
      </object>
    </child>
    <child>
      <object class="GtkBox" id="stars">
        <property name="halign">center</property>
        <property name="valign">center</property>
        <property name="spacing">8</property>
      </object>
    </child>
    <child>
      <object class="GtkMenuButton">
        <property name="icon-name">text-editor-symbolic</property>
        <property name="tooltip-text">Manage Tags</property>
        <style>
          <class name="circular"/>
          <class name="flat"/>
        </style>
        <property name="popover">
          <object class="GtkPopover">
            <property name="width-request">350</property>
            <property name="autohide">true</property>

            <child type="content">

              <object class="GtkBox">
                <property name="orientation">vertical</property>

                <child>
                  <object class="AdwPreferencesPage">
                    <child>
                      <object class="AdwPreferencesGroup">
                        <property name="title">Tags</property>
                        <property name="valign">center</property>

                        <child type="header-suffix">
                          <object class="GtkToggleButton" id="add_tags_toggle">
                            <property name="icon-name">list-add-symbolic</property>
                            <property name="tooltip-text" translatable="yes">Add Tags</property>
                            <property name="active" bind-source="add_tag_menu" bind-property="reveal-child" bind-flags="bidirectional|sync-create"/>
                            <style>
                              <class name="flat"/>
                            </style>
                          </object>
                        </child>

                        <child>
                          <object class="GtkRevealer" id="add_tag_menu">
                            <child>
                              <object class="GtkBox">
                                <property name="orientation">vertical</property>

                                <child>
                                  <object class="GtkSearchEntry" id="add_tag_entry">
                                    <property name="hexpand">true</property>
                                    <signal name="activate" handler="handle_confirm_tag" swapped="true"/>
                                    <signal name="stop_search" handler="hide_tags_menu" swapped="true"/>
                                    <signal name="search_changed" handler="update_tag_buttons" swapped="true"/>
                                    <property name="placeholder-text" translatable="yes">Find or create tags</property>
                                  </object>
                                </child>

                                <child>
                                  <object class="GtkScrolledWindow">
                                    <property name="margin-top">6</property>
                                    <child>
                                      <object class="GtkBox" id="available_tags">
                                        <property name="height-request">16</property>
                                        <property name="spacing">6</property>
                                      </object>
                                    </child>
                                  </object>
                                </child>
                              </object>
                            </child>
                          </object>
                        </child>

                        <child>
                          <object class="AdwWrapBox" id="tags_list">
                            <property name="child-spacing">6</property>
                            <property name="line-spacing">6</property>
                            <property name="margin-start">12</property>
                            <property name="margin-end">12</property>
                            <property name="margin-top">12</property>
                            <property name="margin-bottom">12</property>
                          </object>
                        </child>

                      </object>
                    </child>

                  </object>
                </child>

              </object>
            </child>
          </object>
        </property>
      </object>
    </child>
  </template>
</interface>
