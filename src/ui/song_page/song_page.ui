<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="MellowSongPage" parent="AdwNavigationPage">
    <property name="child">
      <object class="AdwToolbarView">
        <child type="top">
          <object class="AdwHeaderBar">
            <property name="show-title">false</property>
          </object>
        </child>
        <property name="content">
          <object class="AdwPreferencesPage">
            <property name="valign">center</property>
            <child>
              <object class="AdwPreferencesGroup">

                <child>
                  <object class="GtkBox">
                    <property name="orientation">vertical</property>
                    <property name="margin_top">8</property>
                    <property name="spacing">6</property>
                    <property name="halign">center</property>
                    <child>
                      <object class="GtkLabel" id="song_title">
                        <property name="justify">center</property>
                        <property name="wrap">true</property>
                        <property name="wrap-mode">word</property>
                        <style>
                          <class name="heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="album_title">
                        <property name="justify">center</property>
                        <property name="wrap">true</property>
                        <property name="wrap-mode">word</property>
                        <style>
                          <class name="caption-heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="GtkLabel" id="artist_name">
                        <property name="margin-bottom">8</property>
                        <property name="justify">center</property>
                        <property name="wrap">true</property>
                        <property name="wrap-mode">word</property>
                        <style>
                          <class name="caption-heading"/>
                        </style>
                      </object>
                    </child>
                    <child>
                      <object class="MellowRating" id="rating"/>
                    </child>
                  </object>
                </child>
              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup">

                <child>
                  <object class="AdwActionRow">
                    <signal name="activated" handler="handle_play_now" swapped="true"/>
                    <property name="title" translatable="yes">Play Now</property>
                    <property name="activatable">true</property>
                    <child type="prefix">
                      <object class="GtkImage">
                        <property name="icon-name">media-playback-start-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow">
                    <signal name="activated" handler="handle_play_next" swapped="true"/>
                    <property name="title" translatable="yes">Play Next</property>
                    <property name="activatable">true</property>
                    <child type="prefix">
                      <object class="GtkImage">
                        <property name="icon-name">go-next-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow">
                    <signal name="activated" handler="handle_add_to_queue" swapped="true"/>
                    <property name="title" translatable="yes">Add To Queue</property>
                    <property name="activatable">true</property>
                    <child type="prefix">
                      <object class="GtkImage">
                        <property name="icon-name">list-add-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </child>

            <child>
              <object class="AdwPreferencesGroup">

                <child>
                  <object class="AdwActionRow">
                    <signal name="activated" handler="handle_go_to_album" swapped="true"/>
                    <property name="title" translatable="yes">Go To Album</property>
                    <property name="activatable">true</property>
                    <child type="prefix">
                      <object class="GtkImage">
                        <property name="icon-name">media-optical-cd-audio-symbolic</property>
                      </object>
                    </child>
                    <child type="suffix">
                      <object class="GtkImage">
                        <property name="icon-name">go-next-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>

                <child>
                  <object class="AdwActionRow">
                    <signal name="activated" handler="handle_go_to_artist" swapped="true"/>
                    <property name="title" translatable="yes">Go To Artist</property>
                    <property name="activatable">true</property>
                    <child type="prefix">
                      <object class="GtkImage">
                        <property name="icon-name">avatar-default-symbolic</property>
                      </object>
                    </child>
                    <child type="suffix">
                      <object class="GtkImage">
                        <property name="icon-name">go-next-symbolic</property>
                      </object>
                    </child>
                  </object>
                </child>
              </object>
            </child>

          </object>
        </property>
      </object>
    </property>

  </template>
</interface>
