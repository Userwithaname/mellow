<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.userwithaname.Mellow</id>
  <url type="homepage">https://github.com/userwithaname/Mellow/</url>
  <url type="bugtracker">https://github.com/userwithaname/Mellow/issues</url>

  <name>Mellow</name>
  <summary>Distraction-free music listening</summary>
  <project_license>GPL-3.0-or-later</project_license>
  <metadata_license>CC0-1.0</metadata_license>
  <content_rating type="oars-1.1"/>
  <developer id="io.github.userwithaname">
    <name>Iva Kotar</name>
  </developer>

  <description>
    <p>
      Mellow is an experimental music player which strives for an immersive listening experience by minimizing distractions. Non-crucial elements of the interface are hidden away, bringing music to the spotlight.
    </p>
    <p>Features:</p>
    <ul>
      <li>Editable song queue</li>
      <li>Fully-featured local music library</li>
      <li>Library categorization using custom tags</li>
      <li>Displays both synchronized and unsynchronized lyrics</li>
      <li>Detects moved files, so their library data is preserved</li>
      <li>Gapless playback</li>
      <li>MPRIS integration</li>
      <li>Sleek and minimal interface with adaptive colors</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.userwithaname.Mellow.desktop</launchable>

  <screenshots>
    <screenshot type="default">
      <caption>Song queue/main player/library albums page</caption>
      <image>https://github.com/user-attachments/assets/2d76d5d3-a9b8-451d-920d-68d4b217a1b5</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#6fcef2</color>
    <color type="primary" scheme_preference="dark">#b50ef4</color>
  </branding>

  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <requires>
    <display_length compare="ge">360</display_length>
  </requires>

  <releases>
    <release version="0.5.0" date="2026-10-16">
      <description>
        <p>Features &amp; improvements:</p>
        <ul>
          <li>Long-pressing on tag filters now also selects or deselects all other tags</li>
          <li>The interface for renaming tags now includes a button to confirm the rename without using the keyboard</li>
          <li>Dragging an item to the very top or bottom of the queue now pans the view to show more items</li>
          <li>Validating file paths of non-library songs within queue is now much quicker</li>
          <li>Starting a new queue no longer disables repeat mode</li>
          <li>If the player is scheduled to close and the overlay is open, an interactive toast notification is now shown before closing</li>
          <li>The console log now shows timing information, such as how long the application window took to appear</li>
          <li>The application window now opens slightly faster</li>
          <li>Various smaller optimizations</li>
        </ul>
        <p>Fixes:</p>
        <ul>
          <li>Loading a queue with many song files located outside of the configured library directories no longer causes parts of the application to become unresponsive</li>
          <li>Reordering items across the repeat mode wrapping point on short queues now behaves as expected</li>
          <li>Detailed artworks are no longer unnecessarily unloaded while panning the queue</li>
          <li>Fixed an issue preventing component crash handling from working as intended</li>
        </ul>
      </description>
    </release>
    <release version="0.4.5" date="2026-09-18">
      <description>
        <p>Features &amp; improvements:</p>
        <ul>
          <li>Now supports synchronized lyrics (in LRC format)</li>
          <li>Lyrics are now loaded from LRC files when available</li>
          <li>Now loads lyrics from the 'UnsyncedLyrics' tag as well</li>
          <li>When reordering the queue and dragging items off-screen, the queue now scrolls to move the target item into view</li>
          <li>Reordering the queue by dragging items can now be cancelled using the escape key</li>
          <li>Queue selection mode now exits when no more items are selected</li>
          <li>The 'About' dialog now includes a link to the GitHub repository</li>
        </ul>
        <p>Fixes:</p>
        <ul>
          <li>File drop overlay no longer appears when dragging text within the application</li>
          <li>External file drops are now only accepted when no dialog window is open</li>
          <li>In the event of a crash, unaffected components are now more likely to shutdown cleanly</li>
          <li>Crash error messages are now shown more reliably, and encourage users to report the issue</li>
          <li>No longer crashes on launch if the <em>shuffled_queue</em> file is empty or contains no valid entries</li>
          <li>If a crash was caused by a faulty <em>shuffled_queue</em> file, invalid entries are now removed from it on crash</li>
        </ul>
      </description>
    </release>
    <release version="0.4.4" date="2026-09-12">
      <description>
        <p>Features &amp; improvements:</p>
        <ul>
          <li>Tags can now be renamed by long-pressing on an item's assigned tag - renaming a tag will change all instances of that tag to the new name (including on unavailable libraries)</li>
          <li>Buttons for managing item tags now have tooltips</li>
          <li>Improved performance for assigning placeholder artworks</li>
          <li>Small memory and performance optimizations</li>
        </ul>
        <p>Fixes:</p>
        <ul>
          <li>Restoring the favorite status of moved song files and duplicate entries now works as expected</li>
          <li>No longer loses info for missing songs when rebuilding after a previously unavailable library directory becomes available, then closing the application before the missing song entries finish processing</li>
          <li>Fixed queue items losing their thumbnails in some cases</li>
        </ul>
      </description>
    </release>
    <release version="0.4.3" date="2026-08-21"/>
